# .env.example
# Скопировать в .env и заполнить.
# .env загружается автоматически при `uv run`.

# ----------------------------------------------------------------------------
# Обязательное
# ----------------------------------------------------------------------------

# Пароль PostgreSQL (используется в application/config.py -> load_config).
# Игнорируется, если задан в TOML — TOML значение для секретов отбрасывается.
PG_PASSWORD=

# ----------------------------------------------------------------------------
# Опциональное — продакшн-конфигурация
# ----------------------------------------------------------------------------

# Пароль внешнего NTRIP-источника, если в config.toml выставлено
# upstream_ntrip.enabled = true. Логин и URL берутся из TOML; пароль — только отсюда.
UPSTREAM_NTRIP_PASSWORD=

# Пароль собственного NTRIP-кастера. Используется, если в config.toml
# local_caster.username задан. Если оба отсутствуют — кастер anonymous.
LOCAL_CASTER_PASSWORD=

# ----------------------------------------------------------------------------
# Опциональное — для отладочных скриптов в scripts/
# ----------------------------------------------------------------------------

# Креды для scripts/probe_ntrip_public.py (BKG EUREF-IP и аналогичных кастеров).
NTRIP_USER=
NTRIP_PASSWORD=

RS3_USER=
RS3_PASSWORD=
